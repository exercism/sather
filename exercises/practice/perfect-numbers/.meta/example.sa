class PERFECT_NUMBERS is

   classify(number : INT) : STR is
      if number < 1 then
         raise "Classification is only possible for positive integers.";
      elsif number = 1 then
         return "deficient";
      end;

      total ::= 1;
      candidate ::= 2;
      loop
         quotient ::= number / candidate;
         remainder ::= number % candidate;
         while!(candidate < quotient);
         if remainder = 0 then
            -- Stop as soon as the total passes number, before it can
            -- grow too large for an INT.
            if candidate + quotient > number - total then
               return "abundant";
            end;
            total := total + candidate + quotient;
         end;
         candidate := candidate + 1;
      end;
      -- candidate * candidate could overflow, so test for a square root
      -- by dividing instead.
      if number % candidate = 0 and number / candidate = candidate then
         total := total + candidate;
      end;

      if total < number then
         return "deficient";
      elsif total > number then
         return "abundant";
      else
         return "perfect";
      end;
   end;

end; -- class PERFECT_NUMBERS
