abstract class $NESTED is

   -- One item of a nested list: a number, nothing at all, or more items.
   -- Sather arrays hold a single type, so a list mixing all three holds
   -- $NESTED, and each kind of item is a class conforming to it. These
   -- classes are given to you, apart from the bodies of gather.

   gather(into : LIST{INT});
      -- Append this item's numbers to `into', in order.

end; -- abstract class $NESTED

class NESTED_NUMBER < $NESTED is

   readonly attr number : INT;

   create(n : INT) : SAME is
      r ::= new;
      r.number := n;
      return r;
   end;

   gather(into : LIST{INT}) is
      -- A number contributes itself.
   end;

end; -- class NESTED_NUMBER

class NESTED_NOTHING < $NESTED is

   create : SAME is
      return new;
   end;

   gather(into : LIST{INT}) is
      -- Nothing contributes no number.
   end;

end; -- class NESTED_NOTHING

class NESTED_ITEMS < $NESTED is

   readonly attr items : ARRAY{$NESTED};

   create(list : ARRAY{$NESTED}) : SAME is
      r ::= new;
      r.items := list;
      return r;
   end;

   gather(into : LIST{INT}) is
      -- A list contributes the numbers of each of its items, in order.
   end;

end; -- class NESTED_ITEMS

class FLATTEN_ARRAY is

   flatten(nested : $NESTED) : ARRAY{INT} is
      -- Every number in the nested list, in order, however deeply buried.
      -- Items holding nothing are left out.
      return #ARRAY{INT}(0);
   end;

end; -- class FLATTEN_ARRAY
