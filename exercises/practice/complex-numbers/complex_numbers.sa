class COMPLEX is

   readonly attr real, imaginary : FLTD;

   create(r, i : FLTD) : SAME is
      return new;
   end;

   plus(other : SAME) : SAME is
      return self;
   end;

   minus(other : SAME) : SAME is
      return self;
   end;

   times(other : SAME) : SAME is
      return self;
   end;

   div(other : SAME) : SAME is
      return self;
   end;

   abs : FLTD is
      return 0.0d;
   end;

   conjugate : SAME is
      return self;
   end;

   exp : SAME is
      return self;
   end;

end; -- class COMPLEX
