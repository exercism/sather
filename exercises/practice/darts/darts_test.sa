class DARTS_TEST is
   include EXERCISM_TEST;

   main is
      class_name("DARTS");

      test("Missed target", DARTS::score((-9.0d), 9.0d), 0);

      test("On the outer circle", DARTS::score(0.0d, 10.0d), 1);

      test("On the middle circle", DARTS::score((-5.0d), 0.0d), 5);

      test("On the inner circle", DARTS::score(0.0d, (-1.0d)), 10);

      test("Exactly on center", DARTS::score(0.0d, 0.0d), 10);

      test("Near the center", DARTS::score((-0.1d), (-0.1d)), 10);

      test("Just within the inner circle", DARTS::score(0.7d, 0.7d), 10);

      test("Just outside the inner circle", DARTS::score(0.8d, (-0.8d)), 5);

      test("Just within the middle circle", DARTS::score((-3.5d), 3.5d), 5);

      test("Just outside the middle circle", DARTS::score((-3.6d), (-3.6d)), 1);

      test("Just within the outer circle", DARTS::score((-7.0d), 7.0d), 1);

      test("Just outside the outer circle", DARTS::score(7.1d, (-7.1d)), 0);

      test("Asymmetric position between the inner and middle circles", DARTS::score(0.5d, (-4.0d)), 5);

      finish;
   end;
end; -- class DARTS_TEST
