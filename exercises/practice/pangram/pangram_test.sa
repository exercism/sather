class PANGRAM_TEST is
   include EXERCISM_TEST;

   main is
      class_name("PANGRAM");

      test("empty sentence", PANGRAM::is_pangram(""), false);

      test("perfect lower case", PANGRAM::is_pangram("abcdefghijklmnopqrstuvwxyz"), true);

      test("only lower case", PANGRAM::is_pangram("the quick brown fox jumps over the lazy dog"), true);

      test("missing the letter 'x'", PANGRAM::is_pangram("a quick movement of the enemy will jeopardize five gunboats"), false);

      test("missing the letter 'h'", PANGRAM::is_pangram("five boxing wizards jump quickly at it"), false);

      test("with underscores", PANGRAM::is_pangram("the_quick_brown_fox_jumps_over_the_lazy_dog"), true);

      test("with numbers", PANGRAM::is_pangram("the 1 quick brown fox jumps over the 2 lazy dogs"), true);

      test("missing letters replaced by numbers", PANGRAM::is_pangram("7h3 qu1ck brown fox jumps ov3r 7h3 lazy dog"), false);

      test("mixed case and punctuation", PANGRAM::is_pangram("\"Five quacking Zephyrs jolt my wax bed.\""), true);

      test("a-m and A-M are 26 different characters but not a pangram", PANGRAM::is_pangram("abcdefghijklm ABCDEFGHIJKLM"), false);

      finish;
   end;
end; -- class PANGRAM_TEST
