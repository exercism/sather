class BANK_ACCOUNT is

   private attr is_open : BOOL;
   private attr held : INT;

   invariant : BOOL is
      -- self is void on entry to create, before there is an account.
      return void(self) or held >= 0;
   end;

   create : SAME is
      res : SAME := new;
      return res;
   end;

   open_account is
   end;

   close_account is
   end;

   balance : INT is
      return 0;
   end;

   deposit(amount : INT) is
   end;

   withdraw(amount : INT) is
   end;

end; -- class BANK_ACCOUNT
