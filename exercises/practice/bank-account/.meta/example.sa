class BANK_ACCOUNT is

   private attr is_open : BOOL;
   private attr held : INT;

   create : SAME is
      res : SAME := new;
      return res;
   end;

   open_account is
      if is_open then raise "account already open" end;
      is_open := true;
      held := 0;
   end;

   close_account is
      if ~is_open then raise "account not open" end;
      is_open := false;
   end;

   balance : INT is
      if ~is_open then raise "account not open" end;
      return held;
   end;

   deposit(amount : INT) is
      if ~is_open then raise "account not open" end;
      if amount <= 0 then raise "amount must be greater than 0" end;
      held := held + amount;
   end;

   withdraw(amount : INT) is
      if ~is_open then raise "account not open" end;
      if amount <= 0 then raise "amount must be greater than 0" end;
      if amount > held then raise "amount must be less than balance" end;
      held := held - amount;
   end;

end; -- class BANK_ACCOUNT
