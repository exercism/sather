class TOURNAMENT_TEST is
   include EXERCISM_TEST;

   main is
      class_name("TOURNAMENT");

      rows_1 : ARRAY{STR} := #ARRAY{STR}(0);
      expected_1 : ARRAY{STR} := |"Team                           | MP |  W |  D |  L |  P"|;
      test("just the header if no input", TOURNAMENT::tally(rows_1).str, expected_1.str);

      rows_2 : ARRAY{STR} := |"Allegoric Alaskans;Blithering Badgers;win"|;
      expected_2 : ARRAY{STR} := |"Team                           | MP |  W |  D |  L |  P", "Allegoric Alaskans             |  1 |  1 |  0 |  0 |  3", "Blithering Badgers             |  1 |  0 |  0 |  1 |  0"|;
      test("a win is three points, a loss is zero points", TOURNAMENT::tally(rows_2).str, expected_2.str);

      rows_3 : ARRAY{STR} := |"Blithering Badgers;Allegoric Alaskans;loss"|;
      expected_3 : ARRAY{STR} := |"Team                           | MP |  W |  D |  L |  P", "Allegoric Alaskans             |  1 |  1 |  0 |  0 |  3", "Blithering Badgers             |  1 |  0 |  0 |  1 |  0"|;
      test("a win can also be expressed as a loss", TOURNAMENT::tally(rows_3).str, expected_3.str);

      rows_4 : ARRAY{STR} := |"Blithering Badgers;Allegoric Alaskans;win"|;
      expected_4 : ARRAY{STR} := |"Team                           | MP |  W |  D |  L |  P", "Blithering Badgers             |  1 |  1 |  0 |  0 |  3", "Allegoric Alaskans             |  1 |  0 |  0 |  1 |  0"|;
      test("a different team can win", TOURNAMENT::tally(rows_4).str, expected_4.str);

      rows_5 : ARRAY{STR} := |"Allegoric Alaskans;Blithering Badgers;draw"|;
      expected_5 : ARRAY{STR} := |"Team                           | MP |  W |  D |  L |  P", "Allegoric Alaskans             |  1 |  0 |  1 |  0 |  1", "Blithering Badgers             |  1 |  0 |  1 |  0 |  1"|;
      test("a draw is one point each", TOURNAMENT::tally(rows_5).str, expected_5.str);

      rows_6 : ARRAY{STR} := |"Allegoric Alaskans;Blithering Badgers;win", "Allegoric Alaskans;Blithering Badgers;win"|;
      expected_6 : ARRAY{STR} := |"Team                           | MP |  W |  D |  L |  P", "Allegoric Alaskans             |  2 |  2 |  0 |  0 |  6", "Blithering Badgers             |  2 |  0 |  0 |  2 |  0"|;
      test("There can be more than one match", TOURNAMENT::tally(rows_6).str, expected_6.str);

      rows_7 : ARRAY{STR} := |"Allegoric Alaskans;Blithering Badgers;loss", "Allegoric Alaskans;Blithering Badgers;win"|;
      expected_7 : ARRAY{STR} := |"Team                           | MP |  W |  D |  L |  P", "Allegoric Alaskans             |  2 |  1 |  0 |  1 |  3", "Blithering Badgers             |  2 |  1 |  0 |  1 |  3"|;
      test("There can be more than one winner", TOURNAMENT::tally(rows_7).str, expected_7.str);

      rows_8 : ARRAY{STR} := |"Allegoric Alaskans;Blithering Badgers;win", "Blithering Badgers;Courageous Californians;win", "Courageous Californians;Allegoric Alaskans;loss"|;
      expected_8 : ARRAY{STR} := |"Team                           | MP |  W |  D |  L |  P", "Allegoric Alaskans             |  2 |  2 |  0 |  0 |  6", "Blithering Badgers             |  2 |  1 |  0 |  1 |  3", "Courageous Californians        |  2 |  0 |  0 |  2 |  0"|;
      test("There can be more than two teams", TOURNAMENT::tally(rows_8).str, expected_8.str);

      rows_9 : ARRAY{STR} := |"Allegoric Alaskans;Blithering Badgers;win", "Devastating Donkeys;Courageous Californians;draw", "Devastating Donkeys;Allegoric Alaskans;win", "Courageous Californians;Blithering Badgers;loss", "Blithering Badgers;Devastating Donkeys;loss", "Allegoric Alaskans;Courageous Californians;win"|;
      expected_9 : ARRAY{STR} := |"Team                           | MP |  W |  D |  L |  P", "Devastating Donkeys            |  3 |  2 |  1 |  0 |  7", "Allegoric Alaskans             |  3 |  2 |  0 |  1 |  6", "Blithering Badgers             |  3 |  1 |  0 |  2 |  3", "Courageous Californians        |  3 |  0 |  1 |  2 |  1"|;
      test("typical input", TOURNAMENT::tally(rows_9).str, expected_9.str);

      rows_10 : ARRAY{STR} := |"Allegoric Alaskans;Blithering Badgers;loss", "Devastating Donkeys;Allegoric Alaskans;loss", "Courageous Californians;Blithering Badgers;draw", "Allegoric Alaskans;Courageous Californians;win"|;
      expected_10 : ARRAY{STR} := |"Team                           | MP |  W |  D |  L |  P", "Allegoric Alaskans             |  3 |  2 |  0 |  1 |  6", "Blithering Badgers             |  2 |  1 |  1 |  0 |  4", "Courageous Californians        |  2 |  0 |  1 |  1 |  1", "Devastating Donkeys            |  1 |  0 |  0 |  1 |  0"|;
      test("incomplete competition (not all pairs have played)", TOURNAMENT::tally(rows_10).str, expected_10.str);

      rows_11 : ARRAY{STR} := |"Courageous Californians;Devastating Donkeys;win", "Allegoric Alaskans;Blithering Badgers;win", "Devastating Donkeys;Allegoric Alaskans;loss", "Courageous Californians;Blithering Badgers;win", "Blithering Badgers;Devastating Donkeys;draw", "Allegoric Alaskans;Courageous Californians;draw"|;
      expected_11 : ARRAY{STR} := |"Team                           | MP |  W |  D |  L |  P", "Allegoric Alaskans             |  3 |  2 |  1 |  0 |  7", "Courageous Californians        |  3 |  2 |  1 |  0 |  7", "Blithering Badgers             |  3 |  0 |  1 |  2 |  1", "Devastating Donkeys            |  3 |  0 |  1 |  2 |  1"|;
      test("ties broken alphabetically", TOURNAMENT::tally(rows_11).str, expected_11.str);

      rows_12 : ARRAY{STR} := |"Devastating Donkeys;Blithering Badgers;win", "Devastating Donkeys;Blithering Badgers;win", "Devastating Donkeys;Blithering Badgers;win", "Devastating Donkeys;Blithering Badgers;win", "Blithering Badgers;Devastating Donkeys;win"|;
      expected_12 : ARRAY{STR} := |"Team                           | MP |  W |  D |  L |  P", "Devastating Donkeys            |  5 |  4 |  0 |  1 | 12", "Blithering Badgers             |  5 |  1 |  0 |  4 |  3"|;
      test("ensure points sorted numerically", TOURNAMENT::tally(rows_12).str, expected_12.str);

      finish;
   end;
end; -- class TOURNAMENT_TEST
