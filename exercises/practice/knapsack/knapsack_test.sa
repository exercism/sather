class KNAPSACK_TEST is
   include EXERCISM_TEST;

   main is
      class_name("KNAPSACK");

      weights_1 : ARRAY{INT} := #ARRAY{INT}(0);
      values_1 : ARRAY{INT} := #ARRAY{INT}(0);
      test("no items", KNAPSACK::maximum_value(weights_1, values_1, 100), 0);

      weights_2 : ARRAY{INT} := |100|;
      values_2 : ARRAY{INT} := |1|;
      test("one item, too heavy", KNAPSACK::maximum_value(weights_2, values_2, 10), 0);

      weights_3 : ARRAY{INT} := |2, 2, 2, 2, 10|;
      values_3 : ARRAY{INT} := |5, 5, 5, 5, 21|;
      test("five items (cannot be greedy by weight)", KNAPSACK::maximum_value(weights_3, values_3, 10), 21);

      weights_4 : ARRAY{INT} := |2, 2, 2, 2, 10|;
      values_4 : ARRAY{INT} := |20, 20, 20, 20, 50|;
      test("five items (cannot be greedy by value)", KNAPSACK::maximum_value(weights_4, values_4, 10), 80);

      weights_5 : ARRAY{INT} := |5, 4, 6, 4|;
      values_5 : ARRAY{INT} := |10, 40, 30, 50|;
      test("example knapsack", KNAPSACK::maximum_value(weights_5, values_5, 10), 90);

      weights_6 : ARRAY{INT} := |25, 35, 45, 5, 25, 3, 2, 2|;
      values_6 : ARRAY{INT} := |350, 400, 450, 20, 70, 8, 5, 5|;
      test("8 items", KNAPSACK::maximum_value(weights_6, values_6, 104), 900);

      weights_7 : ARRAY{INT} := |70, 73, 77, 80, 82, 87, 90, 94, 98, 106, 110, 113, 115, 118, 120|;
      values_7 : ARRAY{INT} := |135, 139, 149, 150, 156, 163, 173, 184, 192, 201, 210, 214, 221, 229, 240|;
      test("15 items", KNAPSACK::maximum_value(weights_7, values_7, 750), 1458);

      finish;
   end;
end; -- class KNAPSACK_TEST
