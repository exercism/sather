class KNAPSACK is

   maximum_value(weights, values : ARRAY{INT}, maximum_weight : INT) : INT
      pre weights.size = values.size and maximum_weight >= 0
      post result >= 0
   is
      -- Greatest total value that fits in `maximum_weight'. Each item may
      -- be taken at most once.
      return 0;
   end;

end; -- class KNAPSACK
