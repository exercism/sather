class AFFINE_CIPHER_TEST is
   include EXERCISM_TEST;

   main is
      class_name("AFFINE_CIPHER");

      test("encode - encode yes", AFFINE_CIPHER::encode("yes", 5, 7), "xbt");

      test("encode - encode no", AFFINE_CIPHER::encode("no", 15, 18), "fu");

      test("encode - encode OMG", AFFINE_CIPHER::encode("OMG", 21, 3), "lvz");

      test("encode - encode O M G", AFFINE_CIPHER::encode("O M G", 25, 47), "hjp");

      test("encode - encode mindblowingly", AFFINE_CIPHER::encode("mindblowingly", 11, 15), "rzcwa gnxzc dgt");

      test("encode - encode numbers", AFFINE_CIPHER::encode("Testing,1 2 3, testing.", 3, 4), "jqgjc rw123 jqgjc rw");

      test("encode - encode deep thought", AFFINE_CIPHER::encode("Truth is fiction.", 5, 17), "iynia fdqfb ifje");

      test("encode - encode all the letters", AFFINE_CIPHER::encode("The quick brown fox jumps over the lazy dog.", 17, 33), "swxtj npvyk lruol iejdc blaxk swxmh qzglf");

      protect
         ignored ::= AFFINE_CIPHER::encode("This is a test.", 6, 17);
         test("encode - encode with a not coprime to m", "no exception raised", "a and m must be coprime.");
      when $STR then
         test("encode - encode with a not coprime to m", exception.str, "a and m must be coprime.");
      end;

      test("decode - decode exercism", AFFINE_CIPHER::decode("tytgn fjr", 3, 7), "exercism");

      test("decode - decode a sentence", AFFINE_CIPHER::decode("qdwju nqcro muwhn odqun oppmd aunwd o", 19, 16), "anobstacleisoftenasteppingstone");

      test("decode - decode numbers", AFFINE_CIPHER::decode("odpoz ub123 odpoz ub", 25, 7), "testing123testing");

      test("decode - decode all the letters", AFFINE_CIPHER::decode("swxtj npvyk lruol iejdc blaxk swxmh qzglf", 17, 33), "thequickbrownfoxjumpsoverthelazydog");

      test("decode - decode with no spaces in input", AFFINE_CIPHER::decode("swxtjnpvyklruoliejdcblaxkswxmhqzglf", 17, 33), "thequickbrownfoxjumpsoverthelazydog");

      test("decode - decode with too many spaces", AFFINE_CIPHER::decode("vszzm    cly   yd cg    qdp", 15, 16), "jollygreengiant");

      protect
         ignored ::= AFFINE_CIPHER::decode("Test", 13, 5);
         test("decode - decode with a not coprime to m", "no exception raised", "a and m must be coprime.");
      when $STR then
         test("decode - decode with a not coprime to m", exception.str, "a and m must be coprime.");
      end;

      test("encode boundary characters", AFFINE_CIPHER::encode("/09:@AMNZ[`amnz{", 25, 12), "09maz nmazn");

      finish;
   end;
end; -- class AFFINE_CIPHER_TEST
