{% import "macros.j2" as m with context %}
{{ m.begin() }}
{% for case in cases %}

{% set call = "AFFINE_CIPHER::" ~ case.property ~ "(" ~ case.input.phrase | sa ~ ", " ~ case.input.key.a | sa ~ ", " ~ case.input.key.b | sa ~ ")" %}
{% if case is error %}
{{ m.test_error(case, call) }}
{% else %}
{{ m.test(case, call, case.expected | sa) }}
{% endif %}
{% endfor %}
{{ m.end() }}
