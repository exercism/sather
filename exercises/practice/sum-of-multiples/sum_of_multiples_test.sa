class SUM_OF_MULTIPLES_TEST is
   include EXERCISM_TEST;

   main is
      class_name("SUM_OF_MULTIPLES");

      factors_1 : ARRAY{INT} := |3, 5|;
      test("no multiples within limit", SUM_OF_MULTIPLES::sum(factors_1, 1), 0);

      factors_2 : ARRAY{INT} := |3, 5|;
      test("one factor has multiples within limit", SUM_OF_MULTIPLES::sum(factors_2, 4), 3);

      factors_3 : ARRAY{INT} := |3|;
      test("more than one multiple within limit", SUM_OF_MULTIPLES::sum(factors_3, 7), 9);

      factors_4 : ARRAY{INT} := |3, 5|;
      test("more than one factor with multiples within limit", SUM_OF_MULTIPLES::sum(factors_4, 10), 23);

      factors_5 : ARRAY{INT} := |3, 5|;
      test("each multiple is only counted once", SUM_OF_MULTIPLES::sum(factors_5, 100), 2318);

      factors_6 : ARRAY{INT} := |3, 5|;
      test("a much larger limit", SUM_OF_MULTIPLES::sum(factors_6, 1000), 233168);

      factors_7 : ARRAY{INT} := |7, 13, 17|;
      test("three factors", SUM_OF_MULTIPLES::sum(factors_7, 20), 51);

      factors_8 : ARRAY{INT} := |4, 6|;
      test("factors not relatively prime", SUM_OF_MULTIPLES::sum(factors_8, 15), 30);

      factors_9 : ARRAY{INT} := |5, 6, 8|;
      test("some pairs of factors relatively prime and some not", SUM_OF_MULTIPLES::sum(factors_9, 150), 4419);

      factors_10 : ARRAY{INT} := |5, 25|;
      test("one factor is a multiple of another", SUM_OF_MULTIPLES::sum(factors_10, 51), 275);

      factors_11 : ARRAY{INT} := |43, 47|;
      test("much larger factors", SUM_OF_MULTIPLES::sum(factors_11, 10000), 2203160);

      factors_12 : ARRAY{INT} := |1|;
      test("all numbers are multiples of 1", SUM_OF_MULTIPLES::sum(factors_12, 100), 4950);

      factors_13 : ARRAY{INT} := #ARRAY{INT}(0);
      test("no factors means an empty sum", SUM_OF_MULTIPLES::sum(factors_13, 10000), 0);

      factors_14 : ARRAY{INT} := |0|;
      test("the only multiple of 0 is 0", SUM_OF_MULTIPLES::sum(factors_14, 1), 0);

      factors_15 : ARRAY{INT} := |3, 0|;
      test("the factor 0 does not affect the sum of multiples of other factors", SUM_OF_MULTIPLES::sum(factors_15, 4), 3);

      factors_16 : ARRAY{INT} := |2, 3, 5, 7, 11|;
      test("solutions using include-exclude must extend to cardinality greater than 3", SUM_OF_MULTIPLES::sum(factors_16, 10000), 39614537);

      finish;
   end;
end; -- class SUM_OF_MULTIPLES_TEST
