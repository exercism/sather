class SADDLE_POINTS_TEST is
   include EXERCISM_TEST;

   main is
      class_name("SADDLE_POINTS");

      matrix_1 : ARRAY{ARRAY{INT}} := | |9, 8, 7|, |5, 3, 2|, |6, 6, 7| |;
      expected_1 : ARRAY{ARRAY{INT}} := | |2, 1| |;
      test("Can identify single saddle point", SADDLE_POINTS::saddle_points(matrix_1).str, expected_1.str);

      matrix_2 : ARRAY{ARRAY{INT}} := |#ARRAY{INT}(0)|;
      expected_2 : ARRAY{ARRAY{INT}} := #ARRAY{ARRAY{INT}}(0);
      test("Can identify that empty matrix has no saddle points", SADDLE_POINTS::saddle_points(matrix_2).str, expected_2.str);

      matrix_3 : ARRAY{ARRAY{INT}} := | |1, 2, 3|, |3, 1, 2|, |2, 3, 1| |;
      expected_3 : ARRAY{ARRAY{INT}} := #ARRAY{ARRAY{INT}}(0);
      test("Can identify lack of saddle points when there are none", SADDLE_POINTS::saddle_points(matrix_3).str, expected_3.str);

      matrix_4 : ARRAY{ARRAY{INT}} := | |4, 5, 4|, |3, 5, 5|, |1, 5, 4| |;
      expected_4 : ARRAY{ARRAY{INT}} := | |1, 2|, |2, 2|, |3, 2| |;
      test("Can identify multiple saddle points in a column", SADDLE_POINTS::saddle_points(matrix_4).str, expected_4.str);

      matrix_5 : ARRAY{ARRAY{INT}} := | |6, 7, 8|, |5, 5, 5|, |7, 5, 6| |;
      expected_5 : ARRAY{ARRAY{INT}} := | |2, 1|, |2, 2|, |2, 3| |;
      test("Can identify multiple saddle points in a row", SADDLE_POINTS::saddle_points(matrix_5).str, expected_5.str);

      matrix_6 : ARRAY{ARRAY{INT}} := | |8, 7, 9|, |6, 7, 6|, |3, 2, 5| |;
      expected_6 : ARRAY{ARRAY{INT}} := | |3, 3| |;
      test("Can identify saddle point in bottom right corner", SADDLE_POINTS::saddle_points(matrix_6).str, expected_6.str);

      matrix_7 : ARRAY{ARRAY{INT}} := | |3, 1, 3|, |3, 2, 4| |;
      expected_7 : ARRAY{ARRAY{INT}} := | |1, 1|, |1, 3| |;
      test("Can identify saddle points in a non square matrix", SADDLE_POINTS::saddle_points(matrix_7).str, expected_7.str);

      matrix_8 : ARRAY{ARRAY{INT}} := | |2|, |1|, |4|, |1| |;
      expected_8 : ARRAY{ARRAY{INT}} := | |2, 1|, |4, 1| |;
      test("Can identify that saddle points in a single column matrix are those with the minimum value", SADDLE_POINTS::saddle_points(matrix_8).str, expected_8.str);

      matrix_9 : ARRAY{ARRAY{INT}} := | |2, 5, 3, 5| |;
      expected_9 : ARRAY{ARRAY{INT}} := | |1, 2|, |1, 4| |;
      test("Can identify that saddle points in a single row matrix are those with the maximum value", SADDLE_POINTS::saddle_points(matrix_9).str, expected_9.str);

      finish;
   end;
end; -- class SADDLE_POINTS_TEST
