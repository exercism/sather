class RESISTOR_COLOR_DUO is

   private code(color : STR) : INT is
      all : ARRAY{STR} := |"black", "brown", "red", "orange", "yellow",
                           "green", "blue", "violet", "grey", "white"|;
      loop
         i ::= 0.upto!(all.size - 1);
         if all[i] = color then return i end;
      end;
      raise "unknown colour";
   end;

   decoded_value(colors : ARRAY{STR}) : INT is
      return 10 * code(colors[0]) + code(colors[1]);
   end;

end; -- class RESISTOR_COLOR_DUO
