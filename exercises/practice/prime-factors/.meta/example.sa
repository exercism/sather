class PRIME_FACTORS is

   factors(number : INT) : ARRAY{INT}
      pre number >= 1
   is
      found ::= #FLIST{INT};
      n ::= number;
      d ::= 2;
      loop
         until!(d > n / d);
         loop
            until!(n % d /= 0);
            found := found.push(d);
            n := n / d;
         end;
         d := d + 1;
      end;
      if n > 1 then found := found.push(n) end;

      return found.as_array;
   end;

end; -- class PRIME_FACTORS
