class HAMMING is

   distance(strand1, strand2 : STR) : INT is
      a ::= strand1; b ::= strand2;
      if void(a) then a := "" end;
      if void(b) then b := "" end;
      if a.size /= b.size then
         raise "strands must be of equal length";
      end;
      d ::= 0;
      loop
         -- Both strands move on together, one letter each turn.
         if a.elt! /= b.elt! then d := d + 1 end;
      end;
      return d;
   end;

end; -- class HAMMING
