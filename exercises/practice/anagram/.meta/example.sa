class ANAGRAM is

   private lower(s : STR) : STR is
      r : FSTR := #FSTR(s.size);
      loop r := r + s.elt!.lower end;
      return r.str;
   end;

   private histogram(s : STR) : ARRAY{INT} is
      counts : ARRAY{INT} := #ARRAY{INT}(26);
      loop
         c ::= s.elt!;
         if c.is_alpha then
            i ::= c.lower.int - 'a'.int;
            counts[i] := counts[i] + 1;
         end;
      end;
      return counts;
   end;

   find(subject : STR, candidates : ARRAY{STR}) : LIST{STR} is
      target ::= lower(subject);
      wanted ::= histogram(subject);
      found ::= #LIST{STR};
      loop
         cand ::= candidates.elt!;
         if lower(cand) /= target and histogram(cand).str = wanted.str then
            found.append(cand);
         end;
      end;

      return found;
   end;

end; -- class ANAGRAM
