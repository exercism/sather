class LINE_UP_TEST is
   include EXERCISM_TEST;

   main is
      class_name("LINE_UP");

      test("format smallest non-exceptional ordinal numeral 4", LINE_UP::format("Gianna", 4), "Gianna, you are the 4th customer we serve today. Thank you!");

      test("format greatest single digit non-exceptional ordinal numeral 9", LINE_UP::format("Maarten", 9), "Maarten, you are the 9th customer we serve today. Thank you!");

      test("format non-exceptional ordinal numeral 5", LINE_UP::format("Petronila", 5), "Petronila, you are the 5th customer we serve today. Thank you!");

      test("format non-exceptional ordinal numeral 6", LINE_UP::format("Attakullakulla", 6), "Attakullakulla, you are the 6th customer we serve today. Thank you!");

      test("format non-exceptional ordinal numeral 7", LINE_UP::format("Kate", 7), "Kate, you are the 7th customer we serve today. Thank you!");

      test("format non-exceptional ordinal numeral 8", LINE_UP::format("Maximiliano", 8), "Maximiliano, you are the 8th customer we serve today. Thank you!");

      test("format exceptional ordinal numeral 1", LINE_UP::format("Mary", 1), "Mary, you are the 1st customer we serve today. Thank you!");

      test("format exceptional ordinal numeral 2", LINE_UP::format("Haruto", 2), "Haruto, you are the 2nd customer we serve today. Thank you!");

      test("format exceptional ordinal numeral 3", LINE_UP::format("Henriette", 3), "Henriette, you are the 3rd customer we serve today. Thank you!");

      test("format smallest two digit non-exceptional ordinal numeral 10", LINE_UP::format("Alvarez", 10), "Alvarez, you are the 10th customer we serve today. Thank you!");

      test("format non-exceptional ordinal numeral 11", LINE_UP::format("Jacqueline", 11), "Jacqueline, you are the 11th customer we serve today. Thank you!");

      test("format non-exceptional ordinal numeral 12", LINE_UP::format("Juan", 12), "Juan, you are the 12th customer we serve today. Thank you!");

      test("format non-exceptional ordinal numeral 13", LINE_UP::format("Patricia", 13), "Patricia, you are the 13th customer we serve today. Thank you!");

      test("format exceptional ordinal numeral 21", LINE_UP::format("Washi", 21), "Washi, you are the 21st customer we serve today. Thank you!");

      test("format exceptional ordinal numeral 22 ending in nd even though it is a multiple of 11", LINE_UP::format("Ingrid", 22), "Ingrid, you are the 22nd customer we serve today. Thank you!");

      test("format exceptional ordinal numeral 33 ending in rd even though it is a multiple of 11", LINE_UP::format("Mario", 33), "Mario, you are the 33rd customer we serve today. Thank you!");

      test("format exceptional ordinal numeral 52 ending in nd even though it is a multiple of 13", LINE_UP::format("Quentin", 52), "Quentin, you are the 52nd customer we serve today. Thank you!");

      test("format exceptional ordinal numeral 62", LINE_UP::format("Nayra", 62), "Nayra, you are the 62nd customer we serve today. Thank you!");

      test("format non-exceptional ordinal numeral 72 ending in nd even though it is a multiple of 12", LINE_UP::format("Ugo", 72), "Ugo, you are the 72nd customer we serve today. Thank you!");

      test("format exceptional ordinal numeral 91 ending in st even though it is a multiple of 13", LINE_UP::format("Boris", 91), "Boris, you are the 91st customer we serve today. Thank you!");

      test("format exceptional ordinal numeral 100", LINE_UP::format("John", 100), "John, you are the 100th customer we serve today. Thank you!");

      test("format exceptional ordinal numeral 101", LINE_UP::format("Zeinab", 101), "Zeinab, you are the 101st customer we serve today. Thank you!");

      test("format non-exceptional ordinal numeral 112", LINE_UP::format("Knud", 112), "Knud, you are the 112th customer we serve today. Thank you!");

      test("format exceptional ordinal numeral 123", LINE_UP::format("Yma", 123), "Yma, you are the 123rd customer we serve today. Thank you!");

      test("format large number 972 ending in nd even though it is a multiple of 12", LINE_UP::format("Elias", 972), "Elias, you are the 972nd customer we serve today. Thank you!");

      finish;
   end;
end; -- class LINE_UP_TEST
