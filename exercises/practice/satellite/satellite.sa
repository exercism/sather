class TREE_NODE is

   attr v : STR;
   attr l, r : TREE_NODE;

   create(val : STR) : SAME is
      res : SAME := new;
      res.v := val;
      return res;
   end;

   postorder! : STR is
   end;

end; -- class TREE_NODE

class SATELLITE is

   tree_from_traversals(preorder, inorder : ARRAY{STR}) : TREE_NODE is
      return void;
   end;

end; -- class SATELLITE
