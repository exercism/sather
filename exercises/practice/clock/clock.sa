class CLOCK is

   readonly attr hour, minute : INT;

   invariant : BOOL is
      -- This is checked on entry to and exit from every public routine;
      -- on entry to create there is no clock yet, and self is void.
      return void(self) or (hour >= 0 and hour < 24 and minute >= 0 and minute < 60);
   end;

   create(h, m : INT) : SAME is
      return new;
   end;

   plus(minutes : INT) : SAME is
      return self;
   end;

   minus(minutes : INT) : SAME is
      return self;
   end;

   is_eq(other : SAME) : BOOL is
      return false;
   end;

   str : STR is
      return "";
   end;

end; -- class CLOCK
