class BINARY_SEARCH_TEST is
   include EXERCISM_TEST;

   main is
      class_name("BINARY_SEARCH");

      haystack_1 : ARRAY{INT} := |6|;
      test("finds a value in an array with one element", BINARY_SEARCH::find(haystack_1, 6), 0);

      haystack_2 : ARRAY{INT} := |1, 3, 4, 6, 8, 9, 11|;
      test("finds a value in the middle of an array", BINARY_SEARCH::find(haystack_2, 6), 3);

      haystack_3 : ARRAY{INT} := |1, 3, 4, 6, 8, 9, 11|;
      test("finds a value at the beginning of an array", BINARY_SEARCH::find(haystack_3, 1), 0);

      haystack_4 : ARRAY{INT} := |1, 3, 4, 6, 8, 9, 11|;
      test("finds a value at the end of an array", BINARY_SEARCH::find(haystack_4, 11), 6);

      haystack_5 : ARRAY{INT} := |1, 3, 5, 8, 13, 21, 34, 55, 89, 144, 233, 377, 634|;
      test("finds a value in an array of odd length", BINARY_SEARCH::find(haystack_5, 144), 9);

      haystack_6 : ARRAY{INT} := |1, 3, 5, 8, 13, 21, 34, 55, 89, 144, 233, 377|;
      test("finds a value in an array of even length", BINARY_SEARCH::find(haystack_6, 21), 5);

      haystack_7 : ARRAY{INT} := |1, 3, 4, 6, 8, 9, 11|;
      protect
         ignored ::= BINARY_SEARCH::find(haystack_7, 7);
         test("identifies that a value is not included in the array", "no exception raised", "value not in array");
      when $STR then
         test("identifies that a value is not included in the array", exception.str, "value not in array");
      end;

      haystack_8 : ARRAY{INT} := |1, 3, 4, 6, 8, 9, 11|;
      protect
         ignored ::= BINARY_SEARCH::find(haystack_8, 0);
         test("a value smaller than the array's smallest value is not found", "no exception raised", "value not in array");
      when $STR then
         test("a value smaller than the array's smallest value is not found", exception.str, "value not in array");
      end;

      haystack_9 : ARRAY{INT} := |1, 3, 4, 6, 8, 9, 11|;
      protect
         ignored ::= BINARY_SEARCH::find(haystack_9, 13);
         test("a value larger than the array's largest value is not found", "no exception raised", "value not in array");
      when $STR then
         test("a value larger than the array's largest value is not found", exception.str, "value not in array");
      end;

      haystack_10 : ARRAY{INT} := #ARRAY{INT}(0);
      protect
         ignored ::= BINARY_SEARCH::find(haystack_10, 1);
         test("nothing is found in an empty array", "no exception raised", "value not in array");
      when $STR then
         test("nothing is found in an empty array", exception.str, "value not in array");
      end;

      haystack_11 : ARRAY{INT} := |1, 2|;
      protect
         ignored ::= BINARY_SEARCH::find(haystack_11, 0);
         test("nothing is found when the left and right bounds cross", "no exception raised", "value not in array");
      when $STR then
         test("nothing is found when the left and right bounds cross", exception.str, "value not in array");
      end;

      haystack_12 : ARRAY{INT} := |11638, 18389, 21454, 29416, 32039|;
      test("five digits", BINARY_SEARCH::find(haystack_12, 21454), 2);

      finish;
   end;
end; -- class BINARY_SEARCH_TEST
