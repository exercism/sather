class PARALLEL_LETTER_FREQUENCY is

   frequency(texts : ARRAY{STR}) : FMAP{STR,INT} is
      -- Sather 1.2's serial runtime has no threads, so this counts the
      -- texts one after another. The result is the same either way; only
      -- the timing would differ.
      counts : FMAP{STR,INT} := #FMAP{STR,INT};
      loop
         text ::= texts.elt!;
         if ~void(text) then
            loop
               c ::= text.elt!;
               if c.is_alpha then
                  key ::= c.lower.str;
                  if counts.has_ind(key) then
                     counts := counts.insert(key, counts.get(key) + 1);
                  else
                     counts := counts.insert(key, 1);
                  end;
               end;
            end;
         end;
      end;
      return counts;
   end;

end; -- class PARALLEL_LETTER_FREQUENCY
