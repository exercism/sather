class LUHN_TEST is
   include EXERCISM_TEST;

   main is
      class_name("LUHN");

      test("single digit strings can not be valid", LUHN::is_valid("1"), false);

      test("a single zero is invalid", LUHN::is_valid("0"), false);

      test("a simple valid SIN that remains valid if reversed", LUHN::is_valid("059"), true);

      test("a simple valid SIN that becomes invalid if reversed", LUHN::is_valid("59"), true);

      test("a valid Canadian SIN", LUHN::is_valid("055 444 285"), true);

      test("invalid Canadian SIN", LUHN::is_valid("055 444 286"), false);

      test("invalid credit card", LUHN::is_valid("8273 1232 7352 0569"), false);

      test("invalid long number with an even remainder", LUHN::is_valid("1 2345 6789 1234 5678 9012"), false);

      test("invalid long number with a remainder divisible by 5", LUHN::is_valid("1 2345 6789 1234 5678 9013"), false);

      test("valid number with an even number of digits", LUHN::is_valid("095 245 88"), true);

      test("valid number with an odd number of spaces", LUHN::is_valid("234 567 891 234"), true);

      test("valid strings with a non-digit added at the end become invalid", LUHN::is_valid("059a"), false);

      test("valid strings with punctuation included become invalid", LUHN::is_valid("055-444-285"), false);

      test("valid strings with symbols included become invalid", LUHN::is_valid("055# 444$ 285"), false);

      test("single zero with space is invalid", LUHN::is_valid(" 0"), false);

      test("more than a single zero is valid", LUHN::is_valid("0000 0"), true);

      test("input digit 9 is correctly converted to output digit 9", LUHN::is_valid("091"), true);

      test("very long input is valid", LUHN::is_valid("9999999999 9999999999 9999999999 9999999999"), true);

      test("valid luhn with an odd number of digits and non zero first digit", LUHN::is_valid("109"), true);

      test("using ascii value for non-doubled non-digit isn't allowed", LUHN::is_valid("055b 444 285"), false);

      test("using ascii value for doubled non-digit isn't allowed", LUHN::is_valid(":9"), false);

      test("non-numeric, non-space char in the middle with a sum that's divisible by 10 isn't allowed", LUHN::is_valid("59%59"), false);

      finish;
   end;
end; -- class LUHN_TEST
