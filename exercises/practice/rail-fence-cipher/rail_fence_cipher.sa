class RAIL_FENCE_CIPHER is

   encode(msg : STR, rails : INT) : STR
      pre rails >= 1
      post result.size = msg.size
   is
      -- Write the message down and up across `rails' rails, then read it
      -- off a rail at a time.
      return msg;
   end;

   decode(msg : STR, rails : INT) : STR
      pre rails >= 1
      post result.size = msg.size
   is
      -- Undo encode.
      return msg;
   end;

end; -- class RAIL_FENCE_CIPHER
