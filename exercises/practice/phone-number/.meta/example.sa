class PHONE_NUMBER is

   clean(phrase : STR) : STR is
      text ::= phrase;
      if void(text) then text := ""; end;
      -- Letters are reported before punctuation, so both passes happen
      -- before either is acted on.
      loop
         if text.elt!.is_alpha then raise "letters not permitted"; end;
      end;
      digits ::= #FSTR;
      loop
         c ::= text.elt!;
         if c.is_digit then
            digits := digits + c;
         elsif ~" ()-.+".contains(c) then
            raise "punctuations not permitted";
         end;
      end;
      number ::= digits.str;
      if number.size < 10 then raise "must not be fewer than 10 digits"; end;
      if number.size > 11 then raise "must not be greater than 11 digits"; end;
      if number.size = 11 then
         if number[0] /= '1' then raise "11 digits must start with 1"; end;
         number := number.tail(10);
      end;
      if number[0] = '0' then raise "area code cannot start with zero"; end;
      if number[0] = '1' then raise "area code cannot start with one"; end;
      if number[3] = '0' then raise "exchange code cannot start with zero"; end;
      if number[3] = '1' then raise "exchange code cannot start with one"; end;
      return number;
   end;

end; -- class PHONE_NUMBER
