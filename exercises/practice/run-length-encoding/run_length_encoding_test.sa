class RUN_LENGTH_ENCODING_TEST is
   include EXERCISM_TEST;

   main is
      class_name("RUN_LENGTH_ENCODING");

      test("run-length encode a string - empty string", RUN_LENGTH_ENCODING::encode(""), "");

      test("run-length encode a string - single characters only are encoded without count", RUN_LENGTH_ENCODING::encode("XYZ"), "XYZ");

      test("run-length encode a string - string with no single characters", RUN_LENGTH_ENCODING::encode("AABBBCCCC"), "2A3B4C");

      test("run-length encode a string - single characters mixed with repeated characters", RUN_LENGTH_ENCODING::encode("WWWWWWWWWWWWBWWWWWWWWWWWWBBBWWWWWWWWWWWWWWWWWWWWWWWWB"), "12WB12W3B24WB");

      test("run-length encode a string - multiple whitespace mixed in string", RUN_LENGTH_ENCODING::encode("  hsqq qww  "), "2 hs2q q2w2 ");

      test("run-length encode a string - lowercase characters", RUN_LENGTH_ENCODING::encode("aabbbcccc"), "2a3b4c");

      test("run-length decode a string - empty string", RUN_LENGTH_ENCODING::decode(""), "");

      test("run-length decode a string - single characters only", RUN_LENGTH_ENCODING::decode("XYZ"), "XYZ");

      test("run-length decode a string - string with no single characters", RUN_LENGTH_ENCODING::decode("2A3B4C"), "AABBBCCCC");

      test("run-length decode a string - single characters with repeated characters", RUN_LENGTH_ENCODING::decode("12WB12W3B24WB"), "WWWWWWWWWWWWBWWWWWWWWWWWWBBBWWWWWWWWWWWWWWWWWWWWWWWWB");

      test("run-length decode a string - multiple whitespace mixed in string", RUN_LENGTH_ENCODING::decode("2 hs2q q2w2 "), "  hsqq qww  ");

      test("run-length decode a string - lowercase string", RUN_LENGTH_ENCODING::decode("2a3b4c"), "aabbbcccc");

      test("encode and then decode - encode followed by decode gives original string", RUN_LENGTH_ENCODING::decode(RUN_LENGTH_ENCODING::encode("zzz ZZ  zZ")), "zzz ZZ  zZ");

      test("long run encode", RUN_LENGTH_ENCODING::encode("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"), "123z");

      test("long run decode", RUN_LENGTH_ENCODING::decode("123z"), "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz");

      finish;
   end;
end; -- class RUN_LENGTH_ENCODING_TEST
