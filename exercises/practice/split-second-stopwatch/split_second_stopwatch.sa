class STOPWATCH is

   create : SAME is
      return new;
   end;

   state : STR
      post result = "ready" or result = "running" or result = "stopped"
   is
      return "ready";
   end;

   advance(by : STR) is
   end;

   start is
   end;

   stop is
   end;

   lap is
   end;

   reset is
   end;

   current_lap : STR
      post result.size = 8
   is
      return "00:00:00";
   end;

   total : STR
      post result.size = 8
   is
      return "00:00:00";
   end;

   previous_laps : ARRAY{STR} is
      return #ARRAY{STR}(0);
   end;

end; -- class STOPWATCH
