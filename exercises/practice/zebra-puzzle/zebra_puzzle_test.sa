class ZEBRA_PUZZLE_TEST is
   include EXERCISM_TEST;

   main is
      class_name("ZEBRA_PUZZLE");

      test("resident who drinks water", ZEBRA_PUZZLE::drinks_water, "Norwegian");

      test("resident who owns zebra", ZEBRA_PUZZLE::owns_zebra, "Japanese");

      finish;
   end;
end; -- class ZEBRA_PUZZLE_TEST
