class SECRET_HANDSHAKE_TEST is
   include EXERCISM_TEST;

   main is
      class_name("SECRET_HANDSHAKE");

      expected_1 : ARRAY{STR} := |"wink"|;
      test("wink for 1", SECRET_HANDSHAKE::commands(1).str, expected_1.str);

      expected_2 : ARRAY{STR} := |"double blink"|;
      test("double blink for 10", SECRET_HANDSHAKE::commands(2).str, expected_2.str);

      expected_3 : ARRAY{STR} := |"close your eyes"|;
      test("close your eyes for 100", SECRET_HANDSHAKE::commands(4).str, expected_3.str);

      expected_4 : ARRAY{STR} := |"jump"|;
      test("jump for 1000", SECRET_HANDSHAKE::commands(8).str, expected_4.str);

      expected_5 : ARRAY{STR} := |"wink", "double blink"|;
      test("combine two actions", SECRET_HANDSHAKE::commands(3).str, expected_5.str);

      expected_6 : ARRAY{STR} := |"double blink", "wink"|;
      test("reverse two actions", SECRET_HANDSHAKE::commands(19).str, expected_6.str);

      expected_7 : ARRAY{STR} := |"jump"|;
      test("reversing one action gives the same action", SECRET_HANDSHAKE::commands(24).str, expected_7.str);

      expected_8 : ARRAY{STR} := #ARRAY{STR}(0);
      test("reversing no actions still gives no actions", SECRET_HANDSHAKE::commands(16).str, expected_8.str);

      expected_9 : ARRAY{STR} := |"wink", "double blink", "close your eyes", "jump"|;
      test("all possible actions", SECRET_HANDSHAKE::commands(15).str, expected_9.str);

      expected_10 : ARRAY{STR} := |"jump", "close your eyes", "double blink", "wink"|;
      test("reverse all possible actions", SECRET_HANDSHAKE::commands(31).str, expected_10.str);

      expected_11 : ARRAY{STR} := #ARRAY{STR}(0);
      test("do nothing for zero", SECRET_HANDSHAKE::commands(0).str, expected_11.str);

      finish;
   end;
end; -- class SECRET_HANDSHAKE_TEST
