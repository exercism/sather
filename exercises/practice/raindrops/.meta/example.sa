class RAINDROPS is

   convert(number : INT) : STR is
      r : FSTR := #FSTR(16);
      if number % 3 = 0 then r := r + "Pling" end;
      if number % 5 = 0 then r := r + "Plang" end;
      if number % 7 = 0 then r := r + "Plong" end;
      if r.size = 0 then return number.str end;
      return r.str;
   end;

end; -- class RAINDROPS
