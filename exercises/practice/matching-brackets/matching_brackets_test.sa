class MATCHING_BRACKETS_TEST is
   include EXERCISM_TEST;

   main is
      class_name("MATCHING_BRACKETS");

      test("paired square brackets", MATCHING_BRACKETS::is_paired("[]"), true);

      test("empty string", MATCHING_BRACKETS::is_paired(""), true);

      test("unpaired brackets", MATCHING_BRACKETS::is_paired("[["), false);

      test("wrong ordered brackets", MATCHING_BRACKETS::is_paired("}{"), false);

      test("wrong closing bracket", MATCHING_BRACKETS::is_paired("{]"), false);

      test("paired with whitespace", MATCHING_BRACKETS::is_paired("{ }"), true);

      test("partially paired brackets", MATCHING_BRACKETS::is_paired("{[])"), false);

      test("simple nested brackets", MATCHING_BRACKETS::is_paired("{[]}"), true);

      test("several paired brackets", MATCHING_BRACKETS::is_paired("{}[]"), true);

      test("paired and nested brackets", MATCHING_BRACKETS::is_paired("([{}({}[])])"), true);

      test("unopened closing brackets", MATCHING_BRACKETS::is_paired("{[)][]}"), false);

      test("unpaired and nested brackets", MATCHING_BRACKETS::is_paired("([{])"), false);

      test("paired and wrong nested brackets", MATCHING_BRACKETS::is_paired("[({]})"), false);

      test("paired and wrong nested brackets but innermost are correct", MATCHING_BRACKETS::is_paired("[({}])"), false);

      test("paired and incomplete brackets", MATCHING_BRACKETS::is_paired("{}["), false);

      test("too many closing brackets", MATCHING_BRACKETS::is_paired("[]]"), false);

      test("early unexpected brackets", MATCHING_BRACKETS::is_paired(")()"), false);

      test("early mismatched brackets", MATCHING_BRACKETS::is_paired("{)()"), false);

      test("math expression", MATCHING_BRACKETS::is_paired("(((185 + 223.85) * 15) - 543)/2"), true);

      test("complex latex expression", MATCHING_BRACKETS::is_paired("\\left(\\begin{array}{cc} \\frac{1}{3} & x\\\\ \\mathrm{e}^{x} &... x^2 \\end{array}\\right)"), true);

      finish;
   end;
end; -- class MATCHING_BRACKETS_TEST
