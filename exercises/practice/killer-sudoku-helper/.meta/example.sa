class KILLER_SUDOKU_HELPER is

   private search(cage_sum, cage_size, start : INT, exclude : ARRAY{INT},
                  chosen : ARRAY{INT}, depth : INT,
                  found : FLIST{ARRAY{INT}}) : FLIST{ARRAY{INT}} is
      if depth = cage_size then
         if cage_sum = 0 then
            row : ARRAY{INT} := #ARRAY{INT}(depth);
            loop
               i ::= 0.upto!(depth - 1);
               row[i] := chosen[i];
            end;
            found := found.push(row);
         end;
         return found;
      end;
      loop
         d ::= start.upto!(9);
         if d <= cage_sum then
            barred ::= false;
            loop
               e ::= exclude.elt!;
               if e = d then barred := true end;
            end;
            if ~barred then
               chosen[depth] := d;
               found := search(cage_sum - d, cage_size, d + 1, exclude,
                              chosen, depth + 1, found);
            end;
         end;
      end;
      return found;
   end;

   combinations(cage_sum, cage_size : INT, exclude : ARRAY{INT})
         : ARRAY{ARRAY{INT}}
      pre cage_size >= 1 and cage_size <= 9
   is
      chosen : ARRAY{INT} := #ARRAY{INT}(cage_size);
      found ::= search(cage_sum, cage_size, 1, exclude, chosen, 0,
                       #FLIST{ARRAY{INT}});
      return found.as_array;
   end;

end; -- class KILLER_SUDOKU_HELPER
