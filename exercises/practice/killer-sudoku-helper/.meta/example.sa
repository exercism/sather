class KILLER_SUDOKU_HELPER is

   private search(cage_sum, cage_size, start : INT, exclude : ARRAY{INT},
                  chosen : ARRAY{INT}, depth : INT,
                  found : LIST{ARRAY{INT}}) is
      if depth = cage_size then
         if cage_sum = 0 then
            row : ARRAY{INT} := #ARRAY{INT}(depth);
            loop
               i ::= 0.upto!(depth - 1);
               row[i] := chosen[i];
            end;
            found.append(row);
         end;
         return;
      end;
      loop
         d ::= start.upto!(9);
         if d <= cage_sum then
            barred ::= false;
            loop
               e ::= exclude.elt!;
               if e = d then barred := true end;
            end;
            if ~barred then
               chosen[depth] := d;
               search(cage_sum - d, cage_size, d + 1, exclude,
                      chosen, depth + 1, found);
            end;
         end;
      end;
   end;

   combinations(cage_sum, cage_size : INT, exclude : ARRAY{INT})
         : ARRAY{ARRAY{INT}}
      pre cage_size >= 1 and cage_size <= 9
   is
      chosen : ARRAY{INT} := #ARRAY{INT}(cage_size);
      found ::= #LIST{ARRAY{INT}};
      search(cage_sum, cage_size, 1, exclude, chosen, 0, found);
      return ARRAY{ARRAY{INT}}::create_from(found);
   end;

end; -- class KILLER_SUDOKU_HELPER
