class ALLERGIES is

   private allergens : ARRAY{STR} is
      return |"eggs", "peanuts", "shellfish", "strawberries",
              "tomatoes", "chocolate", "pollen", "cats"|;
   end;

   allergic_to(item : STR, score : INT) : BOOL is
      all ::= allergens;
      loop
         i ::= 0.upto!(all.size - 1);
         if all[i] = item then return score.bit(i) end;
      end;
      return false;
   end;

   list(score : INT) : ARRAY{STR} is
      all ::= allergens;
      found : FLIST{STR} := #FLIST{STR};
      loop
         i ::= 0.upto!(all.size - 1);
         if score.bit(i) then found := found.push(all[i]) end;
      end;

      res : ARRAY{STR} := #ARRAY{STR}(found.size);
      loop
         j ::= 0.upto!(found.size - 1);
         res[j] := found[j];
      end;
      return res;
   end;

end; -- class ALLERGIES
