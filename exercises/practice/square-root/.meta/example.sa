class SQUARE_ROOT is

   square_root(radicand : INT) : INT is
      n ::= 0;
      loop
         until!(n * n >= radicand);
         n := n + 1;
      end;
      -- n is the first whose square reaches the radicand.
      assert (n - 1) * (n - 1) < radicand;
      return n;
   end;

end; -- class SQUARE_ROOT
