class ALPHAMETICS_TEST is
   include EXERCISM_TEST;

   private map_str(m : FMAP{STR,INT}) : STR is
      -- Keys ascending, "key=value" joined by commas. FMAP iterates in
      -- hash order, which is not comparable.
      if void(m) or m.size = 0 then return "" end;
      keys : ARRAY{STR} := #ARRAY{STR}(m.size);
      i ::= 0;
      loop
         p ::= m.pair!;
         keys[i] := p.t1;
         i := i + 1;
      end;
      loop
         a ::= 0.upto!(keys.size - 1);
         loop
            b ::= (a + 1).upto!(keys.size - 1);
            if keys[b] < keys[a] then
               t ::= keys[a]; keys[a] := keys[b]; keys[b] := t;
            end;
         end;
      end;
      r : FSTR := #FSTR(32);
      loop
         k ::= 0.upto!(keys.size - 1);
         if k > 0 then r := r + "," end;
         r := r + keys[k] + "=" + m.get(keys[k]).str;
      end;
      return r.str;
   end;

   main is
      class_name("ALPHAMETICS");

      test("puzzle with three letters", map_str(ALPHAMETICS::solve("I + BB == ILL")), "B=9,I=1,L=0");

      test("solution must have unique value for each letter", map_str(ALPHAMETICS::solve("A == B")), "");

      test("leading zero solution is invalid", map_str(ALPHAMETICS::solve("ACA + DD == BD")), "");

      test("puzzle with two digits final carry", map_str(ALPHAMETICS::solve("A + A + A + A + A + A + A + A + A + A + A + B == BCC")), "A=9,B=1,C=0");

      test("puzzle with four letters", map_str(ALPHAMETICS::solve("AS + A == MOM")), "A=9,M=1,O=0,S=2");

      test("puzzle with six letters", map_str(ALPHAMETICS::solve("NO + NO + TOO == LATE")), "A=0,E=2,L=1,N=7,O=4,T=9");

      test("puzzle with seven letters", map_str(ALPHAMETICS::solve("HE + SEES + THE == LIGHT")), "E=4,G=2,H=5,I=0,L=1,S=9,T=7");

      test("puzzle with eight letters", map_str(ALPHAMETICS::solve("SEND + MORE == MONEY")), "D=7,E=5,M=1,N=6,O=0,R=8,S=9,Y=2");

      test("puzzle with ten letters", map_str(ALPHAMETICS::solve("AND + A + STRONG + OFFENSE + AS + A + GOOD == DEFENSE")), "A=5,D=3,E=4,F=7,G=8,N=0,O=2,R=1,S=6,T=9");

      test("puzzle with ten letters and 199 addends", map_str(ALPHAMETICS::solve("THIS + A + FIRE + THEREFORE + FOR + ALL + HISTORIES + I + TELL + A + TALE + THAT + FALSIFIES + ITS + TITLE + TIS + A + LIE + THE + TALE + OF + THE + LAST + FIRE + HORSES + LATE + AFTER + THE + FIRST + FATHERS + FORESEE + THE + HORRORS + THE + LAST + FREE + TROLL + TERRIFIES + THE + HORSES + OF + FIRE + THE + TROLL + RESTS + AT + THE + HOLE + OF + LOSSES + IT + IS + THERE + THAT + SHE + STORES + ROLES + OF + LEATHERS + AFTER + SHE + SATISFIES + HER + HATE + OFF + THOSE + FEARS + A + TASTE + RISES + AS + SHE + HEARS + THE + LEAST + FAR + HORSE + THOSE + FAST + HORSES + THAT + FIRST + HEAR + THE + TROLL + FLEE + OFF + TO + THE + FOREST + THE + HORSES + THAT + ALERTS + RAISE + THE + STARES + OF + THE + OTHERS + AS + THE + TROLL + ASSAILS + AT + THE + TOTAL + SHIFT + HER + TEETH + TEAR + HOOF + OFF + TORSO + AS + THE + LAST + HORSE + FORFEITS + ITS + LIFE + THE + FIRST + FATHERS + HEAR + OF + THE + HORRORS + THEIR + FEARS + THAT + THE + FIRES + FOR + THEIR + FEASTS + ARREST + AS + THE + FIRST + FATHERS + RESETTLE + THE + LAST + OF + THE + FIRE + HORSES + THE + LAST + TROLL + HARASSES + THE + FOREST + HEART + FREE + AT + LAST + OF + THE + LAST + TROLL + ALL + OFFER + THEIR + FIRE + HEAT + TO + THE + ASSISTERS + FAR + OFF + THE + TROLL + FASTS + ITS + LIFE + SHORTER + AS + STARS + RISE + THE + HORSES + REST + SAFE + AFTER + ALL + SHARE + HOT + FISH + AS + THEIR + AFFILIATES + TAILOR + A + ROOFS + FOR + THEIR + SAFE == FORTRESSES")), "A=1,E=0,F=5,H=8,I=7,L=2,O=6,R=3,S=4,T=9");

      finish;
   end;
end; -- class ALPHAMETICS_TEST
