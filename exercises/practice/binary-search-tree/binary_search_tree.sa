class BINARY_SEARCH_TREE is

   private attr node_data : STR;
   private attr node_left, node_right : BINARY_SEARCH_TREE;

   create(items : ARRAY{STR}) : SAME is
      -- Insert each item in turn. Anything less than or equal to a node
      -- goes to its left, anything greater to its right.
      res : SAME := new;
      return res;
   end;

   data : STR is
      -- The value at this node.
      return "";
   end;

   left : SAME is
      -- The left subtree, or void.
      return void;
   end;

   right : SAME is
      -- The right subtree, or void.
      return void;
   end;

   sorted_data : ARRAY{STR} is
      -- Every value in the tree, in ascending order.
      return #ARRAY{STR}(0);
   end;

end; -- class BINARY_SEARCH_TREE
