class BINARY_SEARCH_TREE{T < $IS_LT{T}} is

   -- $IS_LT{T} promises `<' and nothing more, so "item is less than or
   -- equal to the node" is written as "the node is not less than item".

   private attr node_data : T;
   private attr node_left, node_right : SAME;

   private insert_into(tree : SAME, item : T) : SAME is
      if void(tree) then
         fresh : SAME := new;
         fresh.node_data := item;
         return fresh;
      end;
      if ~(tree.node_data < item) then
         tree.node_left := insert_into(tree.node_left, item);
      else
         tree.node_right := insert_into(tree.node_right, item);
      end;
      return tree;
   end;

   create(items : ARRAY{T}) : SAME is
      res : SAME := void;
      loop
         res := insert_into(res, items.elt!);
      end;
      return res;
   end;

   data : T is return node_data end;
   left : SAME is return node_left end;
   right : SAME is return node_right end;

   elt! : T is
      -- Yields the values in order: the left subtree's, this node's, then
      -- the right subtree's. An empty tree is void, and yields nothing.
      if void(self) then quit end;
      if ~void(node_left) then
         loop yield node_left.elt! end;
      end;
      yield node_data;
      if ~void(node_right) then
         loop yield node_right.elt! end;
      end;
   end;

   sorted_data : ARRAY{T} is
      found ::= #FLIST{T};
      loop found := found.push(elt!) end;
      return found.array;
   end;

end; -- class BINARY_SEARCH_TREE{T}
