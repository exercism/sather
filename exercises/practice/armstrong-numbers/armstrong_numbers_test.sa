class ARMSTRONG_NUMBERS_TEST is
   include EXERCISM_TEST;

   main is
      class_name("ARMSTRONG_NUMBERS");

      test("Zero is an Armstrong number", ARMSTRONG_NUMBERS::is_armstrong_number(#INTI(0)), true);

      test("Single-digit numbers are Armstrong numbers", ARMSTRONG_NUMBERS::is_armstrong_number(#INTI(5)), true);

      test("There are no two-digit Armstrong numbers", ARMSTRONG_NUMBERS::is_armstrong_number(#INTI(10)), false);

      test("Three-digit number that is an Armstrong number", ARMSTRONG_NUMBERS::is_armstrong_number(#INTI(153)), true);

      test("Three-digit number that is not an Armstrong number", ARMSTRONG_NUMBERS::is_armstrong_number(#INTI(100)), false);

      test("Four-digit number that is an Armstrong number", ARMSTRONG_NUMBERS::is_armstrong_number(#INTI(9474)), true);

      test("Four-digit number that is not an Armstrong number", ARMSTRONG_NUMBERS::is_armstrong_number(#INTI(9475)), false);

      test("Seven-digit number that is an Armstrong number", ARMSTRONG_NUMBERS::is_armstrong_number(#INTI(9926315)), true);

      test("Seven-digit number that is not an Armstrong number", ARMSTRONG_NUMBERS::is_armstrong_number(#INTI(9926314)), false);

      test("Armstrong number containing seven zeroes", ARMSTRONG_NUMBERS::is_armstrong_number(#INTI("186709961001538790100634132976990")), true);

      test("The largest and last Armstrong number", ARMSTRONG_NUMBERS::is_armstrong_number(#INTI("115132219018763992565095597973971522401")), true);

      finish;
   end;
end; -- class ARMSTRONG_NUMBERS_TEST
