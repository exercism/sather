class ARMSTRONG_NUMBERS is

   -- The largest Armstrong number has 39 digits, far past an INT, so the
   -- sum is kept in INTI. Each digit is small, and is read from the text.

   is_armstrong_number(number : INTI) : BOOL is
      text ::= number.str;
      total ::= #INTI(0);
      loop
         d ::= #INTI(text.elt!.digit_value);
         total := total + d.pow(text.size);
      end;
      return total = number;
   end;

end; -- class ARMSTRONG_NUMBERS
