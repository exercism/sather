class CASE_NOTES is

   new_case : FLIST{STR} is
      return #FLIST{STR};
   end;

   add_clue(notes : FLIST{STR}, clue : STR) : FLIST{STR}
      post result.size = initial(notes.size) + 1
   is
      -- The answer is the notebook to use from now on.
      return notes.push(clue);
   end;

   clue_count(notes : FLIST{STR}) : INT is
      return notes.size;
   end;

   rule_out(notes : FLIST{STR}, position : INT) : FLIST{STR}
      pre position >= 0 and position < notes.size
      post result.size = initial(notes.size) - 1
   is
      -- Everything after this position moves up one.
      return notes.delete_ordered(position);
   end;

   summary(notes : FLIST{STR}) : STR is
      line ::= #FSTR;
      loop
         place ::= 1.up!;
         clue ::= notes.elt!;
         if place > 1 then line := line + "; "; end;
         line := line + clue;
      end;
      return line.str;
   end;

   clues(notes : FLIST{STR}) : ARRAY{STR} is
      return notes.as_array;
   end;

end; -- class CASE_NOTES
