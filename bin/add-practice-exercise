#!/usr/bin/env bash

# Synopsis:
# Scaffold the files for a new practice exercise.
# After creating the exercise, follow the instructions in the output.

# Example:
# bin/add-practice-exercise two-fer

# Example with difficulty:
# bin/add-practice-exercise -d 5 two-fer

# Example with author and difficulty:
# bin/add-practice-exercise -a foo -d 3 two-fer

set -euo pipefail
scriptname=$0

help_and_exit() {
    echo >&2 "Scaffold the files for a new practice exercise."
    echo >&2 "Usage: ${scriptname} [-h] [-a author] [-d difficulty] <exercise-slug>"
    echo >&2 "Where: author is the GitHub username of the exercise creator."
    echo >&2 "Where: difficulty is between 1 (easiest) to 10 (hardest)."
    exit 1
}

die() { echo >&2 "$*"; exit 1; }

required_tool() {
    command -v "${1}" >/dev/null 2>&1 ||
        die "${1} is required but not installed. Please install it and make sure it's in your PATH."
}

require_files_template() {
    jq -e --arg key "${1}" '.files[$key] | length > 0' config.json > /dev/null ||
        die "The '.files.${1}' array in the 'config.json' file is empty. Please add at least one file. See https://exercism.org/docs/building/tracks/config-json#h-files for more information."
}

required_tool jq

require_files_template "solution"
require_files_template "test"
require_files_template "example"

[[ -f ./bin/fetch-configlet ]] || die "Run this script from the repo's root directory."

author=''
difficulty='1'
while getopts :ha:d: opt; do
    case $opt in
        h) help_and_exit ;;
        a) author=$OPTARG ;;
        d) difficulty=$OPTARG ;;
        ?) echo >&2 "Unknown option: -$OPTARG"; help_and_exit ;;
    esac
done
shift "$((OPTIND - 1))"

(( $# >= 1 )) || help_and_exit

slug="${1}"

if [[ -z "${author}" ]]; then
    read -rp 'Your GitHub username: ' author
fi

./bin/fetch-configlet
./bin/configlet create --practice-exercise "${slug}" --author "${author}" --difficulty "${difficulty}"
./bin/reorder-exercises

exercise_dir="exercises/practice/${slug}"
snake_slug="${slug//-/_}"
class_name="${snake_slug^^}"

# Every exercise ships the test harness.
cp exercises/practice/hello-world/exercism_test.sa "${exercise_dir}/"

cat > "${exercise_dir}/${snake_slug}.sa" << STUB
class ${class_name} is

   -- TODO: declare the routines under test, with stub bodies.

end; -- class ${class_name}
STUB
cp "${exercise_dir}/${snake_slug}.sa" "${exercise_dir}/.meta/example.sa"

if [[ -f "${XDG_CACHE_HOME:-${HOME}/.cache}/exercism/configlet/problem-specifications/exercises/${slug}/canonical-data.json" ]] ||
   [[ -n "${PROBLEM_SPECIFICATIONS:-}" && -f "${PROBLEM_SPECIFICATIONS}/exercises/${slug}/canonical-data.json" ]]; then
    cat > "${exercise_dir}/.meta/template.j2" << 'TEMPLATE'
{% import "macros.j2" as m with context %}
{{ m.begin() }}
{% for case in cases %}

{# TODO: build the call for each case.property from case.input #}
{% set call = "TODO" %}
{% if case is error %}
{{ m.test_error(case, call) }}
{% else %}
{{ m.test(case, call, case.expected | sa) }}
{% endif %}
{% endfor %}
{{ m.end() }}
TEMPLATE
    test_step="- Write the test template in '${exercise_dir}/.meta/template.j2' (see generator/README.md),
  then generate the tests with 'bin/generate-tests ${slug}'
  - Mark any test cases you don't implement with \"include = false\" in '${exercise_dir}/.meta/tests.toml'
  - Track-specific cases go in '${exercise_dir}/.meta/additional-test-cases.json'"
else
    test_step="- There is no canonical data for ${slug}, so write the tests in '${exercise_dir}/${snake_slug}_test.sa' by hand
  (or put them in '${exercise_dir}/.meta/additional-test-cases.json' and write a template)"
fi

cat << NEXT_STEPS

Your next steps are:
${test_step}
- Declare the routines under test in '${exercise_dir}/${snake_slug}.sa'
- Write the example solution in '${exercise_dir}/.meta/example.sa'
- Verify the example solution passes the tests by running 'bin/verify-exercises-in-docker ${slug}'
- Update the 'difficulty' value for the exercise's entry in the 'config.json' file in the repo's root,
  then run 'bin/reorder-exercises'
- Validate CI using 'bin/configlet lint' and 'bin/configlet fmt'
NEXT_STEPS
